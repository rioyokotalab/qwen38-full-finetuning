# Shared absolute path to this clone on every node.
PROJECT_ROOT=/shared/CHANGE_ME/qwen38-full-finetuning

SLURM_PARTITION=gpu
SLURM_ACCOUNT=
NODES=6
GPUS_PER_NODE=4
GPU_REQUEST_STYLE=per-node
CPUS_PER_TASK=32
MEMORY_REQUEST=0
TIME_LIMIT=01:00:00

HF_HOME=/shared/CHANGE_ME/cache/huggingface
LOG_DIR=/shared/CHANGE_ME/qwen38-full-finetuning/logs

# Optional extra sbatch arguments, one per shell word. Keep blank by default.
SBATCH_EXTRA=
